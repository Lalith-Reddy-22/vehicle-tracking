# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://vtrack:vtrack_pass@localhost:5432/vehicle_tracking?sslmode=disable

# CORS - space-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# WebSocket
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_CLIENT_BUFFER_SIZE=256
